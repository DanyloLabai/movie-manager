# Домени (без https://, без слешу в кінці)- Caddy сам видає TLS-сертифікати на них
DOMAIN=example.com
API_DOMAIN=api.example.com

# Postgres
DB_USER={DB_USER}
DB_PASSWORD={DB_PASSWORD}
DB_NAME={DB_NAME}

# Backend- секрети (JWT_SECRET/JWT_REFRESH_SECRET обов'язкові, бекенд впаде на старті без них)
JWT_SECRET={JWT_SECRET}
JWT_REFRESH_SECRET={JWT_REFRESH_SECRET}
JWT_REFRESH_EXPIRES_IN=30d

GEMINI_API_KEY={API_KEY}
GROQ_API_KEY={API_KEY}
TMDB_API_TOKEN={API_KEY}

# Основний провайдер чат-LLM для AI Chat (пошук фільму за описом), DeepSeek
# V4-Pro. Groq- автоматичний резерв, якщо DeepSeek впаде. Ключ береться на
# platform.deepseek.com.
DEEPSEEK_API_KEY={API_KEY}

# Максимальний час очікування одного виклику AI-провайдера, перш ніж він
# перерветься (і для чату/watch-together- перейде на резервного провайдера).
# Опційно, дефолт 25000мс.
AI_PROVIDER_TIMEOUT_MS=25000

# Swagger UI (/api/docs) за замовчуванням вимкнений у проді (NODE_ENV=production)
# і увімкнений скрізь інде. "true" примусово вмикає його і в проді.
ENABLE_SWAGGER=false

CLOUDINARY_CLOUD_NAME={CLOUD_NAME}
CLOUDINARY_API_KEY={API_KEY}
CLOUDINARY_API_SECRET={API_SECRET}

RESEND_API_KEY={API_KEY}
RECAPTCHA_SECRET_KEY={SECRET_KEY}

VAPID_PUBLIC_KEY={VAPID_PUBLIC_KEY}
VAPID_PRIVATE_KEY={VAPID_PRIVATE_KEY}
VAPID_SUBJECT=mailto:you@example.com

# Email, якому міграція AddIsAdminToUsers видасть isAdmin=true. Опційно.
INITIAL_ADMIN_EMAIL={ADMIN_EMAIL}
# Днів без активності "переглянуто" до нагадування. Опційно, дефолт 14.
WATCHED_REMINDER_DAYS=14

# Frontend (Vite)- вшиваються в статичну збірку під час docker build,
# тому мають вказувати саме на API_DOMAIN вище.
VITE_API_BASE_URL=https://api.example.com
VITE_RECAPTCHA_SITE_KEY={RECAPTCHA_SITE_KEY}
