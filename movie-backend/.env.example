GEMINI_API_KEY={API_KEY}
TMDB_API_TOKEN={API_KEY}
GROQ_API_KEY={API_KEY}

# 1st fallback chat-LLM for AI Chat's movie-by-description search and
# watch-together recommendations (DeepSeek V4-Pro), used if OpenAI errors
# out. Falls back further to Gemini, then Groq. Not used for quiz hints-
# that task doesn't need DeepSeek's stronger recall (the movie's facts are
# already given in the prompt), so it isn't worth the extra latency there.
# Get a key at platform.deepseek.com.
DEEPSEEK_API_KEY={API_KEY}

# Primary chat-LLM for AI Chat's movie-by-description search and
# watch-together recommendations (gpt-5.6-luna, OpenAI responses API).
# Replaced DeepSeek V4-Pro as primary on 2026-09-08: repeated side-by-side
# testing showed matching-or-better recall on vague/niche plot descriptions
# at roughly 1/4 the latency (see compare-deepseek-models.mjs). Falls back to
# DeepSeek, then Gemini, then Groq, if it errors out. Get a key at
# platform.openai.com.
OPEN_AI_API_KEY={API_KEY}

DB_HOST={DB_HOST}
DB_PORT={DB_PORT}
DB_USER={DB_USER}
DB_PASSWORD={DB_PASSWORD}
DB_NAME={DB_NAME}

JWT_SECRET={JWT_SECRET}

# Email that gets isAdmin=true when the AddIsAdminToUsers migration runs.
# Optional- if unset, the migration just adds the column and grants no one admin.
INITIAL_ADMIN_EMAIL={ADMIN_EMAIL}

# Days of no "watched" activity before a user gets an inactivity reminder email.
# Optional- defaults to 14 if unset.
WATCHED_REMINDER_DAYS=14

# Per-user daily caps on AI chat/watch-together requests, to keep the shared
# Groq/Gemini API keys from being exhausted by a single user.
# Optional- default to 15 requests and 60000 tokens per user per 24h if unset.
AI_DAILY_REQUEST_LIMIT=15
AI_DAILY_TOKEN_LIMIT=60000

# Separate daily cap on the "Taste Match" watch-together feature specifically
# (POST /api/ai/watch-together/:friendId, gated by TasteMatchDailyLimitGuard-
# counts watch_together usage log rows since local midnight). Lets a user
# regenerate picks ("Try different picks" button) a few times a day without
# eating into the general AI_DAILY_REQUEST_LIMIT.
# Optional- defaults to 3 if unset.
TASTE_MATCH_DAILY_LIMIT=3

# Separate daily cap on "identify a movie from a photo" (POST
# /api/ai/identify-photo, gated by PhotoIdentifyDailyLimitGuard- counts
# photo_identify usage log rows since local midnight). Kept low since vision
# calls cost more than text ones.
# Optional- defaults to 3 if unset.
PHOTO_IDENTIFY_DAILY_LIMIT=3

# Max time to wait on a single Gemini/Groq call before aborting and (for
# chat/watch-together) falling back to the other provider.
# Optional- defaults to 15000ms if unset.
AI_PROVIDER_TIMEOUT_MS=15000

# Max time to wait on DeepSeek V4-Pro specifically (1st fallback for AI Chat
# and watch-together), before falling back to the next provider. DeepSeek's
# "thinking" mode is what gives it good recall, but a single call has been
# measured taking ~117s end-to-end- so it gets its own much longer timeout
# instead of sharing AI_PROVIDER_TIMEOUT_MS with the fast fallbacks.
# Optional- defaults to 150000ms if unset.
DEEPSEEK_PROVIDER_TIMEOUT_MS=150000

# Max time to wait on gpt-5.6-luna specifically (the primary provider for AI
# Chat and watch-together), before falling back to DeepSeek. Usually answers
# in a few seconds, but one run during testing took ~35s, so it gets its own
# timeout instead of sharing AI_PROVIDER_TIMEOUT_MS with the fast fallbacks.
# Optional- defaults to 60000ms if unset.
OPENAI_PROVIDER_TIMEOUT_MS=60000

# Max time to wait on the Gemini call in photo-identify (last-resort fallback
# for that feature, behind deepseek-flash and gpt-5.6-luna) before giving up.
# Kept apart from AI_PROVIDER_TIMEOUT_MS (15s)- that one is tuned for
# plain-text JSON chat replies, while uploading+processing an image routinely
# takes longer, and a too-short timeout here was cutting Gemini off before it
# could answer.
# Optional- defaults to 30000ms if unset.
PHOTO_IDENTIFY_TIMEOUT_MS=30000

# Max time to wait on the DeepSeek call in photo-identify (primary provider
# for that feature) before falling back to gpt-5.6-luna. deepseek-flash
# answered in 3-35s in testing, so this is kept apart from
# DEEPSEEK_PROVIDER_TIMEOUT_MS (150s, tuned for the text-chat reasoning
# model)- reusing that one made a slow/degraded DeepSeek take 150s to fail
# over instead of a few seconds.
# Optional- defaults to 45000ms if unset.
DEEPSEEK_PHOTO_IDENTIFY_TIMEOUT_MS=45000

# Swagger UI (/api/docs) is on by default outside production and off in
# production. Set to "true" to force it on in production too (e.g. to
# debug a deployed environment).
# Optional- unset means off in prod, on elsewhere.
ENABLE_SWAGGER=false

VAPID_PUBLIC_KEY={VAPID_PUBLIC_KEY}
VAPID_PRIVATE_KEY={VAPID_PRIVATE_KEY}
VAPID_SUBJECT=mailto:you@example.com
